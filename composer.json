{
    "name": "schachbulle/contao-lizenzverwaltung-bundle",
    "type": "contao-bundle",
    "description": "Lizenzverwaltung des Deutschen Schachbundes für Contao 4 und Contao 5. Mit Schnittstelle zum Lizenzmanagement (LiMS) des DOSB.",
    "keywords": [
        "contao",
        "lizenzen",
        "dsb",
        "dosb",
        "lims"
    ],
    "homepage": "https://github.com/Samson1964/contao-lizenzverwaltung-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "contao/core-bundle": "^4.13 || ^5.3",
        "codefog/contao-haste": "^5.4",
        "menatwork/contao-multicolumnwizard-bundle": "^3.6",
        "schachbulle/contao-helper-bundle": "^2.0",
        "phpoffice/phpspreadsheet": "^1.29 || ^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/console": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "symfony/routing": "^5.4 || ^6.0 || ^7.0",
        "symfony/security-core": "^5.4 || ^6.0 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoLizenzverwaltungBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoLizenzverwaltungBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-lizenzverwaltung-bundle/issues",
        "source": "https://github.com/Samson1964/contao-lizenzverwaltung-bundle"
    }
}
